{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Port=3306;Database=hospital_management;User ID=YOUR_USER;Password=YOUR_PASSWORD;SslMode=Preferred;"
  },
  "JwtSettings": {
    "Issuer": "HospitalAPI",
    "Audience": "HospitalAPI.Client",
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "AdminAccount": {
    "Enabled": true,
    "Username": "Admin",
    "Email": "admin@hospital.local",
    "Password": "YOUR_ADMIN_PASSWORD"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://YOUR_FRONTEND_URL"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET",
    "UploadPreset": "YOUR_UPLOAD_PRESET"
  },
  "AllowedHosts": "*"
}